{
  // The simulation must not touch the browser: this project has no DOM lib,
  // so any use of window/document/performance inside core or content fails typecheck.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/core", "src/content"]
}
